{
  "name": "depthbake-runtime",
  "version": "1.0.1",
  "description": "Renderer-agnostic Depthbake runtime for depth-aware creative web assets.",
  "type": "module",
  "license": "MIT",
  "author": "Roukara",
  "repository": {
    "type": "git",
    "url": "https://github.com/roukara/depthbake.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "photo-space",
    "depth",
    "webgl",
    "three.js"
  ],
  "main": "./dist/loader.js",
  "module": "./dist/loader.js",
  "types": "./dist/loader.d.ts",
  "exports": {
    ".": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup loader.ts --format esm --out-dir dist --clean && tsc -p tsconfig.json --outDir dist",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
