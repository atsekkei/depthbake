{
  "name": "photospace-three",
  "version": "0.1.0",
  "description": "three.js loader for Photospace depth-aware creative web assets.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atsekkei/photospace.git",
    "directory": "packages/three"
  },
  "keywords": ["photo-space", "depth", "webgl", "three.js", "loader"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup index.ts --format esm --out-dir dist --clean --external three --external photospace-runtime && tsc -p tsconfig.json --outDir dist",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "three": ">=0.152.0"
  },
  "dependencies": {
    "photospace-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1",
    "tsup": "^8.5.1"
  }
}
